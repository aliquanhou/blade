# ⚔️ Blade Environment Configuration
#
# Copy to .env and fill in your API keys.
# Provider is auto-detected from available keys.

# === Provider Selection ===
# Choose: anthropic (default), deepseek, openai, ollama
# Auto-detected from available API keys if unset.
# BLADE_PROVIDER=deepseek

# === DeepSeek ===
# Provider: deepseek
# Models: deepseek-chat, deepseek-reasoner
# DEEPSEEK_API_KEY=sk-your-key-here

# === OpenAI ===
# Provider: openai
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo
# OPENAI_API_KEY=sk-your-key-here

# === Anthropic ===
# Provider: anthropic (default)
# Models: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-3-5-20241022
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Ollama (Local) ===
# Provider: ollama
# Models: any model pulled locally (llama3.2, mistral, etc.)
# No API key needed for local Ollama.
# OLLAMA_BASE_URL=http://localhost:11434

# === Blade Options ===
# BLADE_MODEL=deepseek-v4-flash
# BLADE_BASE_URL=https://api.deepseek.com
# BLADE_DEBUG=1

# === API Proxy (for non-Anthropic providers) ===
# When using DeepSeek/OpenAI/Ollama with the engine,
# start the proxy and point the engine at it:
#   BLADE_PROXY_PORT=8099
# Then: ANTHROPIC_BASE_URL=http://localhost:8099 blade
